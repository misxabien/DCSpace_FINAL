# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/mobile/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pubmat / marketing assets (keep outside repo)
/public/assets/pubmat/
/public/assets/domini-xode-logo.png

# Capacitor / Android local build junk
/mobile/android/.gradle/
/mobile/android/app/build/
/mobile/android/build/
/mobile/android/local.properties
/mobile/android/captures/
/mobile/ios/App/Pods/
/mobile/ios/DerivedData/
