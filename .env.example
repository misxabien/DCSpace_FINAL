# Copy to .env and fill in values. Restart `npm run dev` after changing these.

MONGODB_URI=
MONGODB_DB_NAME=
JWT_SECRET=

# Dual portal hosts (same Vercel project, two domains)
# Leave empty for path-based mode: /login = user, /admin = admin.
# On Vercel: Project → Settings → Domains — attach both hosts to this project,
# then set these to the hostnames only (no https://).
# Local example: USER=localhost  ADMIN=admin.localhost  (browse http://admin.localhost:3000)
NEXT_PUBLIC_USER_HOST=
NEXT_PUBLIC_ADMIN_HOST=

# Atlas: Network Access must allow your current IP (or 0.0.0.0/0 for school/dev).
# Cluster must be running (not paused).

# Gmail SMTP — verification codes are emailed to the registrant
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DC Space <noreply@sdca.edu.ph>

# If SMTP fails, print the code in the terminal so registration can continue (default: on)
VERIFICATION_SMTP_FALLBACK=true
# Set true only for local debugging (always print code, skip real email)
VERIFICATION_LOG_CODE=false

# Gemini — Google AI Studio free key (server only)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash (current free-tier Flash).
GEMINI_MODEL=gemini-3.6-flash

# Shared secret for eRoomReserve → POST /api/integrations/reservation-info
# Authorization: Bearer <this value>
RESERVATION_STATUS_SYNC_SECRET=

# DC Space → eRoomReserve reservation create
# POST https://eroomreserve.vercel.app/api/integrations/dc-space/reservations
EROOMRESERVE_RESERVATIONS_URL=https://eroomreserve.vercel.app/api/integrations/dc-space/reservations
DC_SPACE_RESERVATION_CREATE_SECRET=
EROOMRESERVE_APP_URL=https://eroomreserve.vercel.app

# Optional Firebase path (legacy / dual-write). Leave empty to use HTTP only.
IROOM_FIREBASE_PROJECT_ID=
IROOM_FIREBASE_SERVICE_ACCOUNT=
IROOM_APP_URL=https://eroomreserve.vercel.app
IROOM_WEBHOOK_SECRET=
