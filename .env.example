# Copy to .env.local and fill in values. Restart `npm run dev` after changing these.

MONGODB_URI=
MONGODB_DB_NAME=
JWT_SECRET=

# Gemini — Google AI Studio free key (server only)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash (current free-tier Flash).
GEMINI_MODEL=gemini-3.6-flash
